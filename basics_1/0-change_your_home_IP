#!/usr/bin/env bash
# Configures /etc/hosts so localhost resolves to 127.0.0.2 and facebook.com resolves to 8.8.8.8

# Create a temporary file
temp_hosts=$(mktemp)

# Replace 127.0.0.1 with 127.0.0.2
sed 's/127\.0\.0\.1/127\.0\.0\.2/g' /etc/hosts > "$temp_hosts"

# Update facebook.com if it exists, otherwise append it
if grep -q "facebook\.com" "$temp_hosts"; then
    sed -i 's/.*facebook\.com.*/8.8.8.8 facebook.com/' "$temp_hosts"
else
    echo "8.8.8.8 facebook.com" >> "$temp_hosts"
fi

# Overwrite /etc/hosts content directly to preserve the bind-mount inode
cp "$temp_hosts" /etc/hosts
rm -f "$temp_hosts"
